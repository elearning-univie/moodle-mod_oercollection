{{!
    @template mod_oercollection/oercollection

    Example context (json):
    {
    }
}}
<div class="row mt-1 mb-3">
    <div class="col-auto">
        {{#searchoer}}
            <a class="btn btn-primary me-2" href="{{searchoer}}">
                {{#str}} oersearchlink, mod_oercollection {{/str}}
            </a>
        {{/searchoer}}
        {{#studentpreviewlink}}
            <a class="btn btn-secondary d-none" href="{{studentpreviewlink}}">
                {{#str}} studentpreviewlink, mod_oercollection {{/str}}
            </a>
        {{/studentpreviewlink}}
    </div>
</div>

<div class="row py-3">
    <div class="col">
        <h3 class="h5 mb-0">
            {{#str}} resources, mod_oercollection {{/str}}
        </h3>
    </div>
</div>

<div class="row py-0">
    <div class="table-responsive">
        <table class="table table-borderless mb-0">
            <tbody>
            <tr>
                {{#oerexists}}
                    <td class="fw-bold ps-0 w-100">
                        {{#str}}
                            availableresourcesnumberinfo, mod_oercollection, { "total": {{oernumber}}, "hidden": {{oernumberhidden}} }
                        {{/str}}
                    </td>
                {{/oerexists}}
                {{^oerexists}}
                    <td class="fw-bold ps-0 w-100">
                        {{#str}} noresources, mod_oercollection {{/str}}
                    </td>
                {{/oerexists}}
            </tr>
            </tbody>
        </table>
    </div>
</div>
{{#oerresourcelist}}
    <div class="row py-1">
        <div class="col-auto">
            <a href="#" onclick="mod_oercollection_setall(true)">
                {{#str}} checkall, mod_oercollection {{/str}}
            </a>
        </div>
        <div class="col-auto">
            <a href="#" onclick="mod_oercollection_setall(false)">
                {{#str}} checknone, mod_oercollection {{/str}}
            </a>
        </div>
    </div>
{{/oerresourcelist}}
{{#oerresourcelist}}
    <div class="card mb-3 resource-frame {{background}}">
        <div class="card-body">
            <div class="row align-items-center flex-nowrap">
                <!-- Checkbox Column -->
                <div class="col-auto">
                    <div class="form-check">
                        <input class="form-check-input mod-oercollection-checkbox" type="checkbox" name="selectbox" id="checkbox{{oerentryid}}" onchange="mod_oercollection_cb_selected()" value="{{oerentryid}}">
                        <!-- Empty label with link target if needed -->
                        <label class="form-check-label" for="checkbox{{oerentryid}}">
                            <a id="resourcelink{{oerentryid}}" href="{{resourcelink}}" target="_blank"></a>
                        </label>
                    </div>
                </div>

                <!-- Main Content Column -->
                <div class="col">
                    {{{oerhtml}}}
                    {{#oerhidden}}
                    <div class="row">
                        <div class="col-auto">
                            <span class="badge badge-secondary">{{#str}} hiddenfromstudents {{/str}}</span>
                        </div>
                    </div>
                    {{/oerhidden}}

                    <!-- Optional Comment Section -->
                    {{#commentexists}}
                        <hr>
                        <div class="row">
                            <div class="col">
                                <strong>{{{commentname}}}</strong>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                {{{commenttext}}}
                            </div>
                        </div>
                    {{/commentexists}}
                </div>

                <!-- 3-Dot Dropdown Column -->
                <div class="col-auto p-0 align-self-start">
                    <div class="dropdown">
                        <button class="btn btn-light rounded-circle" type="button" id="dropdownMenuButton{{oerentryid}}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fa fa-ellipsis-v"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton{{oerentryid}}">
                            <a class="dropdown-item" href="{{commentlink}}">
                                {{#pix}} a/setting, core {{/pix}}
                                {{#str}} editcomment, mod_oercollection {{/str}}
                            </a>
                            <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#moveModal{{oerentryid}}">
                                {{#pix}} i/dragdrop, core {{/pix}}
                                {{#str}} move, mod_oercollection {{/str}}
                            </a>
                            {{#oerhidden}}
                                <a class="dropdown-item" href="#"
                                   onclick="mod_oercollection_set_visibility_oerentry({{oerid}}, {{oerentryid}}, 1)">
                                    {{#pix}} i/hide, core {{/pix}}
                                    {{#str}} showoer, mod_oercollection {{/str}}
                                </a>
                            {{/oerhidden}}
                            {{^oerhidden}}
                                <a class="dropdown-item" href="#"
                                   onclick="mod_oercollection_set_visibility_oerentry({{oerid}}, {{oerentryid}}, 0)">
                                    {{#pix}} i/show, core {{/pix}}
                                    {{#str}} hideoer, mod_oercollection {{/str}}
                                </a>
                            {{/oerhidden}}
                            <a class="dropdown-item" href="#"
                               onclick="mod_oercollection_delete_oerentry({{oerid}}, {{oerentryid}}, '{{resourcename}}')">
                                {{#pix}} i/trash, core {{/pix}}
                                {{#str}} removeoer, mod_oercollection {{/str}}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for Moving Resource -->
    <div class="modal fade" id="moveModal{{oerentryid}}" tabindex="-1" role="dialog" aria-labelledby="moveModalLabel{{oerentryid}}" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header justify-content-between">

                      <h5 class="modal-title" id="moveModalLabel{{oerentryid}}">
                          {{#str}} moveresource, mod_oercollection {{/str}}
                      </h5>


                      <button type="button" class="close text-end" data-bs-dismiss="modal" aria-label="{{#str}} closebuttontitle, core {{/str}}">
                          <span aria-hidden="true">&times;</span>
                      </button>

                </div>
                <!-- Modal Body -->
                <div class="modal-body">
                    <div class="mb-3">
                        <span>{{#str}} insertafter, mod_oercollection {{/str}}</span>
                    </div>
                    <div class="list-group">
                        {{#page}}
                            <div class="mb-2">
                                <h6>
                                    <a class="d-flex justify-content-between align-items-center text-decoration-none" data-bs-toggle="collapse" href="#collapseOptions{{pnr}}" aria-expanded="false" aria-controls="collapseOptions{{pnr}}">
                                        {{title}}
                                        <i class="fa fa-chevron-down"></i>
                                    </a>
                                </h6>
                                <div class="collapse" id="collapseOptions{{pnr}}">
                                    <ul class="list-group list-group-flush">
                                        {{#lines}}
                                            {{#.}}
                                                <li class="list-group-item p-1">
                                                    <a href="#" {{#hidden}}class="text-muted"{{/hidden}}
                                                       onclick="mod_oercollection_move_resource_action({{oerid}}, {{oerentryid}}, {{id}})" data-bs-dismiss="modal">
                                                        {{name}}
                                                    </a>
                                                </li>
                                            {{/.}}
                                        {{/lines}}
                                    </ul>
                                </div>
                            </div>
                        {{/page}}
                    </div>
                </div>
            </div>
        </div>
    </div>
{{/oerresourcelist}}

{{#js}}
    require(['mod_oercollection/defaultcontroller'], function(defaultcontroller) {
        defaultcontroller.init();
    });
    require(['mod_oercollection/resourcecontroller'], function(resourcecontroller) {
        resourcecontroller.init();
    });
{{/js}}
