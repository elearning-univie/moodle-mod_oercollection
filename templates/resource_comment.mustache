{{!
    @template mod_oercollection/resource_comment

    Shared comment section for OER resources - used by all three main views

    Example context (json):
    {
        "commentexists": true,
        "commentname": "Comment Title",
        "commenttext": "<p>Comment content</p>",
        "oerentryid": 123
    }
}}
{{#commentexists}}
    <hr>
    <div class="row">
        <div class="col mb-1">
            <strong>{{{commentname}}}</strong>
        </div>
    </div>
    <div class="row">
        <div class="col" style="min-width: 0; max-width: 100%; overflow: hidden;">
            <div class="oer-comment-container" style="max-width: 100%; overflow: hidden;">
                <div class="oer-comment-text" data-entry-id="{{oerentryid}}" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; line-height: 1.5em; max-height: 4.40em; word-wrap: break-word; overflow-wrap: anywhere; word-break: break-all;">
                    {{{commenttext}}}
                </div>
                <a href="#" class="oer-comment-toggle d-none" data-entry-id="{{oerentryid}}" data-expanded="false" style="display: block; text-align: right;">
                    <small class="toggle-text"></small>
                    <i class="fa fa-chevron-down toggle-icon" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
{{/commentexists}}
