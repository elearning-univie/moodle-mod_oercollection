{{!
    @template mod_oercollection/api_warning

    API unavailable warning alert partial.
    Used when OERhub API is not available.

    Context variables required:
    * apiwarning - Warning message text

    Example context (json):
    {
        "apiwarning": "OER resources are temporarily unavailable"
    }
}}
{{#apiwarning}}
<div class="alert alert-warning mb-3">
    <strong>{{#str}} warning, core {{/str}}:</strong> {{apiwarning}}
</div>
{{/apiwarning}}
