{{!
    @template mod_oercollection/oercollection

    Example context (json):
    {
        "actionurl": "https://moodleurl.com"
    }
}}
<div class="row mb-3">
    <div class="col-auto">
        {{#searchoer}}
            <a class="btn btn-secondary" href="{{searchoer}}">
                {{#str}} backtoresources, mod_oercollection {{/str}}
            </a>
        {{/searchoer}}
    </div>
</div>

<div class="row align-items-center py-3">
    <div class="col-auto">
        <h4 class="mb-0">
            {{#str}} searchoerhub, mod_oercollection {{/str}}
        </h4>
    </div>
    {{#helpicon}}
        <div class="col-auto">
            {{> core/help_icon }}
        </div>
    {{/helpicon}}

</div>

{{#apiwarning}}
<div class="alert alert-warning mb-3">
    <strong>{{#str}} warning, core {{/str}}:</strong> {{apiwarning}}
</div>
{{/apiwarning}}

<form action="{{actionurl}}" method="post" id="searchform" class="mt-2">
    {{{searchform}}}

    {{{resultlist}}}
</form>
