{{!
    @template mod_oercollection/oercollection

    Example context (json):
    {
    }
}}
<p>{{#searchoer}}<a class="btn btn-secondary" href="{{searchoer}}">{{#str}} backtoresources, mod_oercollection {{/str}}</a>{{/searchoer}}</p>
<h4>{{# str }} searchoerhub, mod_oercollection {{/ str }}</h4>

<form action="{{actionurl}}" method="post" id="searchform" onsubmit="packData()">
    <input type="hidden" name="filterdata" id="filterdata">
    {{{searchform}}}

    {{{resultlist}}}
    
    <div class="row py-1">
        <div class="d-flex p-0">
            <div class="p-1">
                <label class="mr-1" for="editoptionselect">{{#str}}selectdotdot, mod_oercollection{{/str}}</label>
                <select class="custom-select" id="editoptionselect">
                    <option value="1">{{#str}}openselected, mod_oercollection{{/str}}</option>
                    <option value="5">{{#str}}addselected, mod_oercollection{{/str}}</option>
                </select>
            </div>
            <div class="p-1 ml-1 flex-grow-1">
                <a class="btn btn-primary" href="#" onclick="$.mod_oercollection_bulk_action({{oerid}})"> {{#str}}
                    start, mod_oercollection {{/str}}</a>
            </div>
        </div>
    </div>	
    
</form>
{{#js}}
    packData = () => {
        const selectElements = document.querySelectorAll('select.filterdata');
        const selectedValues = {};

        selectElements.forEach(select => {
            const id = select.id;
            const selectedValue = select.value;
            if (id === 'yearfrom' || id === 'yearto') {
                if (document.getElementById(id + 'checkbox').checked == false) {
                    return;
                }
            }
            selectedValues[id] = selectedValue;
        });

        document.getElementById('filterdata').value = JSON.stringify(selectedValues);
        window.console.log(selectedValues);
    };
    require(['mod_oercollection/defaultcontroller'], function(defaultcontroller) {
        defaultcontroller.init();
    });	
{{/js}}