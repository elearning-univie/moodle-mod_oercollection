{{!
    @template mod_oercollection/collectionmain

    Example context (json):
    {
    }
}}
<div id="region-main-box">
    <div class="row py-3">
        <div class="col alert alert-info mb-0">
            {{#str}} overviewinfo, mod_oercollection {{/str}}
        </div>
    </div>
    <div class="row py-3">
        <div class="container px-0">
            {{#oerresourcelink}}
                <a class="btn btn-secondary me-2 mb-2" href="{{oerresourcelink}}">
                    {{#str}} oerresourcelink, mod_oercollection {{/str}}
                </a>
            {{/oerresourcelink}}
            {{#oersearchlink}}
                <a class="btn btn-primary me-2 mb-2" href="{{oersearchlink}}">
                    {{#str}} oersearchlink, mod_oercollection {{/str}}
                </a>
            {{/oersearchlink}}
            {{#studentpreviewlink}}
                <a class="btn btn-secondary me-2 mb-2" href="{{studentpreviewlink}}">
                    {{#str}} studentpreviewlink, mod_oercollection {{/str}}
                </a>
            {{/studentpreviewlink}}
        </div>
    </div>
    <div class="row py-3">
        <div class="col">
            <h3 class="h5 mb-0">
                {{#str}} overview, core_group {{/str}}
            </h3>
        </div>
    </div>
    <div class="row py-3">
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <tbody>
                    <tr>
                        <td class="w-30">{{#str}} availableresources, mod_oercollection {{/str}}</td>
                        {{#oerexists}}
                        <td>
                            <a href="{{oerresourcelink}}">{{#str}} linkallresources, mod_oercollection, {{oeretotalnumber}} {{/str}}</a>
                            {{#str}} of, mod_oercollection {{/str}}<br>
                            <a href="{{oerresourcelinkvisible}}">{{#str}} linkvisibleresources, mod_oercollection, {{oerevisiblenumber}} {{/str}}</a><br>
                            <a href="{{oerresourcelinkhidden}}">{{#str}} linkhiddenresources, mod_oercollection, {{oerehiddennumber}} {{/str}}</a>
                        </td>
                        {{/oerexists}}
                        {{^oerexists}}
                        <td>
                            {{#oerresourcelink}}
                            <a href="{{oerresourcelink}}">0</a>
                            {{/oerresourcelink}}
                        </td>
                        {{/oerexists}}
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
