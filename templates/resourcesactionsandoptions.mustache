{{!
    @template mod_oercollection/oercollection

    Example context (json):
    {
        "actionurl": "http://moodleinstance/mod/oercollection/resources.php"
    }
}}

<div class="row py-1 mt-4">
    <h4>
        <a class="icons-collapse-expand notextdecoration" data-bs-toggle="collapse" href="#collapseOptions"
           aria-expanded="false" aria-controls="collapseOptions">
            <span class="collapsed-icon icon-no-margin me-1"
                  title="{{#str}} expand, core {{/str}}">
                <span class="dir-rtl-hide">{{#pix}} t/collapsedchevron, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} t/collapsedchevron_rtl, core {{/pix}}</span>
                <span class="visually-hidden">{{#str}} expand, core {{/str}}</span>
            </span>
            <span class="expanded-icon icon-no-margin me-1"
                  title="{{#str}} collapse, core {{/str}}">
                {{#pix}} t/expandedchevron, core {{/pix}}
                <span class="visually-hidden">{{#str}} collapse, core {{/str}}</span>
            </span>
            {{#str}} options, mod_oercollection {{/str}}
        </a>
    </h4>
</div>

<div class="row py-1">
    <div class="d-flex flex-column flex-fill">
        <div class="collapse show" id="collapseOptions">
            <form method="get" action="{{{actionurl}}}" id="oercollectionform">
                {{#filter}}
                    <input type="hidden" name="cmid" value="{{id}}">
                {{/filter}}
                {{^filter}}
                    <input type="hidden" name="id" value="{{id}}">
                {{/filter}}
                <input type="hidden" name="sesskey" value="{{sesskey}}">

                <!-- Filter -->
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-3">
                        <label class="me-2" for="oerefilter">
                            {{#str}} filter, mod_oercollection {{/str}}
                        </label>
                    </div>
                    <div class="col-12 col-md-9">
                        <select class="form-select" id="oerefilter" name="oerefilter" onchange="this.form.submit()">
                            <option value="1" title="{{#str}} nofilters, mod_oercollection {{/str}}" {{#selected21}}selected{{/selected21}}>
                                {{#str}} nofilters, mod_oercollection {{/str}}
                            </option>
                            <option value="2" title="{{#str}} onlyvisible, mod_oercollection {{/str}}" {{#selected22}}selected{{/selected22}}>
                                {{#str}} onlyvisible, mod_oercollection {{/str}}
                            </option>
                            <option value="3" title="{{#str}} onlyhidden, mod_oercollection {{/str}}" {{#selected23}}selected{{/selected23}}>
                                {{#str}} onlyhidden, mod_oercollection {{/str}}
                            </option>
                        </select>
                    </div>
                </div>

                <!-- Resources per page -->
                <div class="row g-2 align-items-center mt-2">
                    <div class="col-12 col-md-3">
                        <label for="perpage">
                            {{#str}} resourcesperpage, mod_oercollection {{/str}}
                        </label>
                    </div>
                    <div class="col-12 col-md-9">
                        <select class="form-select" id="perpage" name="perpage" onchange="this.form.submit()">
                            <option value="5" title="5" {{#selected5}}selected{{/selected5}}>5</option>
                            <option value="10" title="10" {{#selected10}}selected{{/selected10}}>10</option>
                            <option value="20" title="20" {{#selected20}}selected{{/selected20}}>20</option>
                            <option value="50" title="50" {{#selected50}}selected{{/selected50}}>50</option>
                            <option value="100" title="100" {{#selected100}}selected{{/selected100}}>100</option>
                            <option value="5000" title="5000" {{#selected5000}}selected{{/selected5000}}>
                                {{#str}} dropdownall, mod_oercollection {{/str}}
                            </option>
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>