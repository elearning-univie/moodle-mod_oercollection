{{!
    @template mod_oercollection/oercollection

    Example context (json):
    {
    }
}}
<p>{{{intro}}}</p>
{{#apiwarning}}
    {{{apiwarning}}}
{{/apiwarning}}
{{# oerresourcelist}}
    <div class="card mb-3 resource-frame {{background}}">
        <div class="card-body">
            <div class="row align-items-center flex-nowrap">
                <div class="col">
                    {{{oerhtml}}}
                    {{#resourceloadfailed}}
                        <div class="alert alert-warning mb-2">
                            <small><strong>{{#str}} warning, core {{/str}}:</strong> {{#str}} resourceloadfailed, oerapi_oerhub {{/str}}</small>
                        </div>
                    {{/resourceloadfailed}}
                    {{#oerhidden}}
                        <div class="row">
                            <div class="col-auto">
                                <span class="badge badge-secondary">{{#str}} hiddenfromstudents {{/str}}</span>
                            </div>
                        </div>
                    {{/oerhidden}}

                    <!-- Optional Comment Section -->
                    {{#commentexists}}
                        <hr>
                        <div class="row">
                            <div class="col">
                                <strong>{{{commentname}}}</strong>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                {{{commenttext}}}
                            </div>
                        </div>
                    {{/commentexists}}
                </div>
            </div>
        </div>
    </div>
{{/ oerresourcelist}}
