{{!
    @template mod_oercollection/oercourseinfo

    V2 - Refactored to use partials
    Course page inline display of OER collection

    Example context (json):
    {
        "intro": "<p>Introduction text</p>",
        "apiwarning": "Warning message",
        "oerresourcelist": []
    }
}}
<p>{{{intro}}}</p>
{{> mod_oercollection/api_warning }}
{{#oerresourcelist}}
    <div class="card mb-3 resource-frame {{background}}">
        <div class="card-body">
            <div class="row align-items-center flex-nowrap">
                <div class="col">
                    {{> mod_oercollection/resource_card_content }}
                </div>
            </div>
        </div>
    </div>
{{/oerresourcelist}}
