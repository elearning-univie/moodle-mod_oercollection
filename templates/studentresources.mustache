{{!
    @template mod_oercollection/oercollection

    Example context (json):
    {
        "actionurl": "https://moodleurl.com"
    }
}}
<div id="region-main-box">
    {{#backtoteacherview}}
    <div class="row py-3">
        <h2>
            {{# str }} studentpreviewlink, mod_oercollection {{/ str }}
        </h2>
    </div>
    <div class="row mt-1 mb-3">
        <a class="btn btn-secondary" href="{{backtoteacherviewlink}}">{{#str}} back {{/str}}</a>
    </div>
    {{/backtoteacherview}}

    <div class="row py-3">
        <h3>
            {{# str }} resources, mod_oercollection {{/ str }}
        </h3>
    </div>

    <div class="row py-3 mb-4 alert-info infobox">
        <div class="col">
            {{notification}}
            {{# str}} studentinfodetailed, mod_oercollection {{/str}}
        </div>
    </div>

    {{# oerresourcelist}}
    <div class="card mb-3 resource-frame {{background}}">
        <div class="card-body">
            <div class="row align-items-center flex-nowrap">
                <div class="col">
                    {{{oerhtml}}}
                    {{#oerhidden}}
                        <div class="row">
                            <div class="col-auto">
                                <span class="badge badge-secondary">{{#str}} hiddenfromstudents {{/str}}</span>
                            </div>
                        </div>
                    {{/oerhidden}}

                    <!-- Optional Comment Section -->
                    {{#commentexists}}
                        <hr>
                        <div class="row">
                            <div class="col">
                                <strong>{{{commentname}}}</strong>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                {{{commenttext}}}
                            </div>
                        </div>
                    {{/commentexists}}
                </div>
            </div>
        </div>
    </div>
    {{/ oerresourcelist}}

    <div class="row py-1">
        <h4>
        <a class="icons-collapse-expand notextdecoration" data-toggle="collapse" href="#collapseOptions" aria-expanded="false" aria-controls="collapseOptions">
            <span class="collapsed-icon icon-no-margin mr-1"
            title="{{#str}} expand, core {{/str}}">
                <span class="dir-rtl-hide">{{#pix}} t/collapsedchevron, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} t/collapsedchevron_rtl, core {{/pix}}</span>
                <span class="sr-only">{{#str}} expand, core {{/str}}</span>
            </span>
            <span class="expanded-icon icon-no-margin mr-1"
            title="{{#str}} collapse, core {{/str}}">
                {{#pix}} t/expandedchevron, core {{/pix}}
                <span class="sr-only">{{#str}} collapse, core {{/str}}</span>
            </span>
            {{# str }} options, mod_oercollection {{/ str }}
        </a>
        </h4>
    </div>
    <div class="row py-1">
        <div class="collapse show" id="collapseOptions">
            <form method="get" action="{{{actionurl}}}" id="oerstudentcollectionform">
                <input type="hidden" name="id" value="{{id}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <label for="perpage">{{#str}} resourcesperpage, mod_oercollection {{/str}}</label>
                <select id="perpage" name="perpage" onchange="this.form.submit()">
                    <option value="10" title="10" {{#selected10}}selected{{/selected10}}>10</option>
                    <option value="20" title="20" {{#selected20}}selected{{/selected20}}>20</option>
                    <option value="50" title="50" {{#selected50}}selected{{/selected50}}>50</option>
                    <option value="100" title="100" {{#selected100}}selected{{/selected100}}>100</option>
                    <option value="5000" title="5000" {{#selected5000}}selected{{/selected5000}}>{{# str }} dropdownall, mod_oercollection {{/ str }}</option>
                </select>
            </form>
        </div>
    </div>
</div>