{{!
    @template mod_oercollection/oercollection

    Example context (json):
    {
    }
}}
<div id="region-main-box">
    <div class="row py-3 alert-secondary">
        <div class="col">
          {{# str}} studentinfoshort, mod_oercollection {{/str}}
        </div>
    </div>


  <div class="row py-3">
    <h3>
      {{# str }} resources, mod_oercollection {{/ str }}
    </h3>
  </div>

    <div class="row py-3 alert-info infobox">
        <div>
            <div class="col">
                {{notification}}
                {{# str}} studentinfodetailed, mod_oercollection {{/str}}
            </div>
        </div>
    </div>

  <div class="row py-3">
      <div class="table-responsive">
      <table class="table table-bordered">
        <tbody>
          <tr>
            {{#oerexists}}
              <td style="width:100%">{{#str}} availableresources, mod_oercollection {{/str}}</td>
            {{/oerexists}}
            {{^oerexists}}
              <td style="width:100%">{{#str}} noresources, mod_oercollection {{/str}}</td>
            {{/oerexists}}
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</div>