{{!
    @template mod_oercollection/resource_card_content

    Core content display for OER resources (HTML, warnings, badges, comments)
    Used by all three main views

    Example context (json):
    {
        "oerhtml": "<div>Resource HTML</div>",
        "resourceloadfailed": false,
        "oerhidden": false,
        "commentexists": true,
        "commentname": "Comment Title",
        "commenttext": "<p>Comment content</p>",
        "oerentryid": 123
    }
}}
{{{oerhtml}}}

{{#resourceloadfailed}}
    <div class="alert alert-warning mb-2">
        <small><strong>{{#str}} warning, core {{/str}}:</strong> {{#str}} resourceloadfailed, oercollection {{/str}}</small>
    </div>
{{/resourceloadfailed}}

<div class="row oer-hidden-badge"{{^oerhidden}} style="display: none;"{{/oerhidden}}>
    <div class="col-auto">
        <span class="badge text-bg-secondary">{{#str}} hiddenfromstudents {{/str}}</span>
    </div>
</div>

{{> mod_oercollection/resource_comment }}
