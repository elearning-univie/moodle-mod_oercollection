{{!
    @template mod_oercollection/oercollection

    Example context (json):
    {
    }
}}
<div id="region-main-box">
    <div class="row py-3 alert-info infobox">
        <div>
            <div class="col">
                {{notification}}
                {{# str}} overviewinfo, mod_oercollection {{/str}}
            </div>
        </div>
    </div>
    <div class="row py-3">
    <div class="container">
        {{#oerresourcelink}}<a class="btn btn-secondary" href="{{oerresourcelink}}">{{#str}} oerresourcelink, mod_oercollection {{/str}}</a>{{/oerresourcelink}}
        {{#oersearchlink}}<a class="btn btn-primary" href="{{oersearchlink}}">{{#str}} oersearchlink, mod_oercollection {{/str}}</a>{{/oersearchlink}}
        {{#studentpreviewlink}}<a class="btn btn-secondary" href="{{studentpreviewlink}}">{{#str}} studentpreviewlink, mod_oercollection {{/str}}</a>{{/studentpreviewlink}}
    </div>
  </div>
  <div class="row py-3">
    <h3>
      {{# str }} overview, core_group {{/ str }}
    </h3>
  </div>

  <div class="row py-3">
    <div class="table-responsive">
      <table class="table table-bordered">
        <tbody>
          <tr>
            <td style="width:30%">{{#str}} availableresources, mod_oercollection {{/str}}</td>
            {{#oerexists}}
              <td>schalalama</td>
            {{/oerexists}}
            {{^oerexists}}
              <td>{{#link}}<a href="{{link}}">0</a>{{/link}}</td>
            {{/oerexists}}
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</div>